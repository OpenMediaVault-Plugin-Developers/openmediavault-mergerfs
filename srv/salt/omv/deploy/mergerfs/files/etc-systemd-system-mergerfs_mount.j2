{%- set mntDir = mntdir %}
{%- set fsname = pool.name ~ ':' ~ pool.uuid %}
{%- set options = [] %}
{%- set _ = options.append('category.create=' ~ pool.createpolicy) %}
{%- set _ = options.append('minfreespace=' ~ pool.minfreespace | string ~ pool.minfreespaceunit) %}
{%- set _ = options.append('fsname=' ~ fsname) %}
{%- for option in pool.options.split(',') %}
{%- if option | trim and not 'category.create=' in option %}
{%- set _ = options.append(option) %}
{%- endif %}
{%- endfor %}
{%- set branches = [] %}
{%- set reqMnts = [] %}
{%- set branchDirs = pool.paths.split(':') %}
{%- for dir in branchDirs %}
{%- if dir | length > 2 %}
{%- set parents = salt['cmd.run_stdout']('omv-findmnt ' ~ dir | quote, python_shell=False) %}
{%- set _ = branches.append(dir) %}
{%- for parent in parents.splitlines() %}
{%- if parent | length > 1 and parent not in reqMnts %}
{%- set _ = reqMnts.append(parent) %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor -%}
{%- set optline = 'branches=' ~ branches | join(':') ~ ',' ~ options | join(',') %}
[Unit]
Description = MergerFS mount for {{ pool.name }}
After=zfs-mount.target
RequiresMountsFor={% for m in reqMnts %}"{{ m }}"{% if not loop.last %} {% endif %}{% endfor %}

[Mount]
What = {{ fsname }}
Where = {{ mntDir }}
Type = fuse.mergerfs
Options = {{ optline }}

[Install]
WantedBy=multi-user.target
